{
  "name": "eslint-plugin-markdown-links-unlinked",
  "version": "0.1.0",
  "description": "An ESLint plugin that reports Markdown pages not linked from any root page.",
  "type": "module",
  "exports": {
    ".": "./src/index.js",
    "./package.json": "./package.json"
  },
  "files": [
    "src/",
    "README.md",
    "LICENSE",
    "CHANGELOG.md",
    "CONTRIBUTING.md",
    "DESIGN.md",
    "RELEASING.md"
  ],
  "engines": {
    "node": "^22.13.0 || >=24.0.0"
  },
  "scripts": {
    "test": "node --test",
    "test:coverage": "c8 --reporter=text --reporter=lcov npm test",
    "lint": "npm run lint:code && npm run lint:markdown && npm run lint:workflows",
    "lint:code": "eslint .",
    "lint:markdown": "eslint --config eslint.config-markdown.js \"*.md\"",
    "lint:workflows": "node scripts/check-workflow-names.js",
    "package:check": "node --test test/package.test.js"
  },
  "peerDependencies": {
    "@eslint/markdown": "^8.0.0 || ^9.0.0",
    "eslint": "^9.39.0 || ^10.0.0"
  },
  "devDependencies": {
    "@cspell/dict-software-terms": "^5.4.11",
    "@eslint/js": "^10.0.1",
    "@eslint/markdown": "^9.0.0",
    "c8": "^12.0.0",
    "eslint": "^10.15.0",
    "eslint-plugin-markdown-preferences": "^0.43.0",
    "eslint-plugin-markdown-preferences-paragraph": "^0.2.0",
    "eslint-plugin-prose-spellcheck": "^0.1.2",
    "title-case": "^4.3.2",
    "yaml": "^2.9.1"
  },
  "overrides": {
    "eslint-plugin-markdown-preferences": {
      "@eslint/markdown": "$@eslint/markdown"
    },
    "eslint-plugin-markdown-preferences-paragraph": {
      "@eslint/markdown": "$@eslint/markdown"
    },
    "eslint-plugin-prose-spellcheck": {
      "@eslint/markdown": "$@eslint/markdown"
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dblock/eslint-plugin-markdown-links-unlinked.git"
  },
  "bugs": {
    "url": "https://github.com/dblock/eslint-plugin-markdown-links-unlinked/issues"
  },
  "homepage": "https://github.com/dblock/eslint-plugin-markdown-links-unlinked#readme",
  "license": "MIT",
  "author": "dblock",
  "keywords": [
    "eslint",
    "eslintplugin",
    "markdown",
    "links",
    "orphan",
    "unlinked"
  ],
  "c8": {
    "include": [
      "src/**/*.js",
      "scripts/**/*.js"
    ]
  }
}
